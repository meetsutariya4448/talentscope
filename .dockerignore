# terraform/.terraform holds the downloaded provider plugin binaries — 648 MB
# of hashicorp/aws for this repo, which was silently landing in the image via
# `COPY . .` and dwarfing the application itself. Nothing under terraform/ is
# read at runtime; it is infrastructure definition, not app code.
terraform/
.github/
# NOTE: dashboard/ is intentionally NOT excluded — app/main.py serves it as
# static files at runtime (StaticFiles mount at /dashboard).
